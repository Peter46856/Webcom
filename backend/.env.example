# Used by Docker Compose. For Maven, set these in your shell or IDE environment.
SUPABASE_URL=https://your-project.supabase.co
# Server-only secret or legacy service_role key. Never put this in NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=replace-with-your-supabase-server-key
WEBCOM_API_TOKEN=replace-with-a-long-random-secret
